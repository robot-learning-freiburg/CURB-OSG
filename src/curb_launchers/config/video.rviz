    Splitter Ratio: 0.5886790156364441
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.40305009484291077
  - Class: rviz/Time
    Name: Time
    SyncMode: 0
    SyncSource: Stereo 0
